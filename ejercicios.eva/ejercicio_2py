
puntuacion = float(input("Ingrese su puntuación de evaluación (0.0, 0.4 o 0.6+): "))

if puntuacion == 0.0:
    nivel = "Inaceptable"
elif puntuacion == 0.4:
    nivel = "Aceptable"
elif puntuacion >= 0.6:
    nivel = "Meritorio"
else:
    nivel = "Puntuación no válida"

if nivel != "Puntuación no válida":
    dinero_extra = 250000 * puntuacion
    print(f"Su nivel de rendimiento es: {nivel}")
    print(f"Recibirá ${dinero_extra} de dinero extra")
else:
    print("Error: La puntuación ingresada no es válida. Debe ser 0.0, 0.4 o 0.6+")